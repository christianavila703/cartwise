# PostgreSQL connection used by the app.
# Long-running server (next dev / next start): Supabase session pooler, port 5432 (fastest with Prisma)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?connection_limit=5"
# Serverless hosts like Vercel: Supabase transaction pooler, port 6543
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection used by Prisma migrations (Supabase: session pooler, port 5432)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Public base URL prepended to product image paths, e.g. https://res.cloudinary.com/<cloud>/image/upload
# leave empty to serve images from /public
NEXT_PUBLIC_IMAGE_BASE_URL=""

# Cloudinary API credentials, server-only (used by `npm run images:upload`): cloudinary://<key>:<secret>@<cloud>
CLOUDINARY_URL=""

# Admin user created by `npm run db:seed`
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
